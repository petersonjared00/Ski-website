# Copy to .env and fill in. Never commit .env or put this key in browser code.
OPENAI_API_KEY=sk-...
# Image model. gpt-image-2 accepts any WIDTHxHEIGHT divisible by 16, up to 3:1.
IMAGE_MODEL=gpt-image-2
# 3:1 is the widest the API allows. The site crops the middle band for the ski.
IMAGE_SIZE=2544x848
# low | medium | high. Use low or medium for previews; high costs several times more.
IMAGE_QUALITY=medium
# Spend guards
PER_VISITOR_DAILY_LIMIT=5
GLOBAL_DAILY_LIMIT=150
PORT=3000
